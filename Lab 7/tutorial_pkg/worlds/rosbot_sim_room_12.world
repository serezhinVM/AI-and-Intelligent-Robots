<?xml version="1.0" ?>
<!-- rosbot_sim_room_12.world
     2.5 x 2.5 m room, corner at the origin (0,0). All objects are placed at the
     assignment's design coordinates, so the Gazebo world frame == the map frame
     used by the controller:
       robot start (spawned by the launch):   (0.30, 0.30)
       pillars (radius 0.125 m):              (0.8,1.5) (0.8,2.25) (1.7,1.0) (2.2,1.3)
       charger (visual marker, no collision): (2.25, 0.25)
     Appearance reproduces the provided rosbot_sim_room_12.world (grey room and
     pillars, yellow charger, grey background, shadows); the GUI opens top-down.
-->
<sdf version="1.6">
  <world name="default">

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- GUI opens top-down on the room centre, zoomed out (z=5.5) and rotated
         90 deg (yaw=pi) so the charger sits bottom-left
         (screen up = -X, screen right = +Y) -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.25 1.25 5.5 0 1.5708 3.14159</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Room walls (thin boxes, 1.0 m high); interior corners (0,0)-(2.5,2.5) -->
    <model name="walls">
      <static>1</static>
      <link name="link">
        <collision name="c_bottom"><pose>1.25 0 0.5 0 0 0</pose><geometry><box><size>2.6 0.1 1.0</size></box></geometry></collision>
        <visual    name="v_bottom"><pose>1.25 0 0.5 0 0 0</pose><geometry><box><size>2.6 0.1 1.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="c_top"><pose>1.25 2.5 0.5 0 0 0</pose><geometry><box><size>2.6 0.1 1.0</size></box></geometry></collision>
        <visual    name="v_top"><pose>1.25 2.5 0.5 0 0 0</pose><geometry><box><size>2.6 0.1 1.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="c_left"><pose>0 1.25 0.5 0 0 0</pose><geometry><box><size>0.1 2.6 1.0</size></box></geometry></collision>
        <visual    name="v_left"><pose>0 1.25 0.5 0 0 0</pose><geometry><box><size>0.1 2.6 1.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="c_right"><pose>2.5 1.25 0.5 0 0 0</pose><geometry><box><size>0.1 2.6 1.0</size></box></geometry></collision>
        <visual    name="v_right"><pose>2.5 1.25 0.5 0 0 0</pose><geometry><box><size>0.1 2.6 1.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 4 pillars, radius 0.125 m, height 0.75 m, at the design coordinates (grey) -->
    <model name="pillar_T1"><static>1</static><pose>0.8 2.25 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.125</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.125</radius><length>0.75</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_T2"><static>1</static><pose>0.8 1.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.125</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.125</radius><length>0.75</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_T3"><static>1</static><pose>1.7 1.0 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.125</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.125</radius><length>0.75</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_T4"><static>1</static><pose>2.2 1.3 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.125</radius><length>0.75</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.125</radius><length>0.75</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Charger: flat yellow marker at (2.25,0.25), VISUAL only (no collision) -->
    <model name="charger"><static>1</static><pose>2.25 0.25 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.125</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0 1</ambient><diffuse>0.9 0.9 0 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
