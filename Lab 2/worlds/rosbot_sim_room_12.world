        <visual name="visual">
          <geometry><box><size>0.05 2.5 0.3</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
      <pose>2.5 1.25 0.15 0 0 0</pose>
