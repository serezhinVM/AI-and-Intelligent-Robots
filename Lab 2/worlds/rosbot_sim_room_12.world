          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
      <pose>0 1.25 0.15 0 0 0</pose>
    </model>
    <!-- Right wall -->
    <model name="wall_right">
      <static>true</static>
